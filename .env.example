# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO: ATRIO MÓVIL (.env.example)
# Copia este archivo a `.env` y completa con los valores facilitados por el equipo de Odoo
# ==============================================================================

# 1. CONEXIÓN AL BACKEND ODOO 19 ERP
# URL base del servidor Odoo (debe ser HTTPS en producción y staging)
ODOO_BASE_URL=https://staging-erp.atrio.org

# Nombre exacto de la base de datos de Odoo
ODOO_DATABASE=atrio_staging

# Ruta del endpoint para Social Login en Odoo 19 (Controlador personalizado)
ODOO_SOCIAL_AUTH_ENDPOINT=/api/v1/auth/social_login

# Ruta del endpoint para solicitud de eliminación de cuenta en Odoo 19
ODOO_DELETE_ACCOUNT_ENDPOINT=/api/v1/user/delete_account

# 2. CREDENCIALES OAUTH / SOCIAL LOGIN
# Client ID de Google Cloud Console (OAuth 2.0 Web / Android / iOS)
GOOGLE_SERVER_CLIENT_ID=TU_GOOGLE_SERVER_CLIENT_ID.apps.googleusercontent.com

# Service ID de Apple Developer Console
APPLE_SERVICE_ID=org.atrio.app.signin

# 3. LLAVES DE SERVICIOS EXTERNOS (GCP / MAPS)
# En Google Cloud Console, RESTRINGIR SIEMPRE esta clave a:
# - Aplicación Android: com.atrio.atrio_app (con SHA-1 del certificado)
# - APIs permitidas: Maps SDK for Android, Places API (New)
GOOGLE_MAPS_API_KEY=AIzaSy_TU_LLAVE_DE_GOOGLE_MAPS_AQUI

# 4. CONFIGURACIÓN DE LA APP
APP_ENVIRONMENT=development
