#!/usr/bin/env sh
# ==============================================================================
# ATRIO / GLOBAL - GIT PRE-COMMIT SECURITY HOOK
# Previene la fuga accidental de credenciales, secretos, API Keys y llaves privadas.
# ==============================================================================

# Colores para la salida en consola
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # Sin color

echo "${BLUE}[SEGURIDAD] Escaneando archivos staged antes del commit...${NC}"

# ------------------------------------------------------------------------------
# 1. VERIFICACIÓN DE NOMBRES DE ARCHIVOS SENSIBLES
# ------------------------------------------------------------------------------
FORBIDDEN_NAME_PATTERNS="(\.env($|\..*)|.*credentials.*\.json|.*service-account.*\.json|\.keystore$|\.jks$|\.p12$|\.key$|.*INVENTARIO.*|.*credenciales.*|local\.properties$|key\.properties$)"
ALLOWLIST_FILES="\.env\.example$|\.env\.template$|\.env\.sample$"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

FILE_ERROR=0
for FILE in $STAGED_FILES; do
    # Si coincide con patrón prohibido
    if echo "$FILE" | grep -iE "$FORBIDDEN_NAME_PATTERNS" > /dev/null 2>&1; then
        # Verificar si está en la lista permitida de ejemplos
        if ! echo "$FILE" | grep -iE "$ALLOWLIST_FILES" > /dev/null 2>&1; then
            echo "${RED}[BLOQUEO CRÍTICO] Archivo sensible detectado en el commit:${NC} $FILE"
            FILE_ERROR=1
        fi
    fi
done

if [ $FILE_ERROR -ne 0 ]; then
    echo ""
    echo "${RED}❌ COMMIT CANCELADO: Hay archivos con información sensible preparados para subir a Git.${NC}"
    echo "Ejecuta: ${YELLOW}git reset HEAD <archivo>${NC} para sacarlo del commit y verifica tu .gitignore."
    exit 1
fi

# ------------------------------------------------------------------------------
# 2. ESCANEO DE PATRONES DE SECRETOS EN LÍNEAS AGREGADAS
# ------------------------------------------------------------------------------
# Expresiones regulares de secretos comunes:
# - Google API Key: AIza... (35 caracteres siguientes)
# - Llaves privadas: -----BEGIN ... PRIVATE KEY-----
# - AWS Access Key: AKIA... (16 caracteres)
# - GitHub Personal Access Token: ghp_..., github_pat_...
# - OpenAI API Key: sk-..., sk-proj-...
# - Slack API Token: xox[baprs]-...
# - Stripe Live Secret Key: sk_live_...

SECRET_REGEX="AIza[0-9A-Za-z_-]{35}|-----BEGIN[ A-Z0-9_-]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ghp_[0-9a-zA-Z]{36}|github_pat_[0-9a-zA-Z_]{22,}|sk-[a-zA-Z0-9]{20,}|sk-proj-[a-zA-Z0-9_-]{20,}|xox[baprs]-[0-9a-zA-Z]{10,48}|sk_live_[0-9a-zA-Z]{24}"

# Obtenemos solo las líneas agregadas (+) en los archivos staged (excluyendo hooks y ejemplos)
DIFF_ADDED=$(git diff --cached -U0 --diff-filter=ACM -- . ":!.githooks/*" ":!.env.example" ":!scripts/*" | grep '^+[^+]')

LEAKED_MATCHES=$(echo "$DIFF_ADDED" | grep -E "$SECRET_REGEX")

if [ -n "$LEAKED_MATCHES" ]; then
    echo ""
    echo "${RED}======================================================================${NC}"
    echo "${RED}🚨 ALERTA CRÍTICA DE SEGURIDAD: DETECCIÓN DE API KEY / SECRETO${NC}"
    echo "${RED}======================================================================${NC}"
    echo "${YELLOW}Se detectaron posibles credenciales reales expuestas en tu código:${NC}"
    echo ""
    echo "$LEAKED_MATCHES" | head -n 10
    echo ""
    echo "${RED}❌ EL COMMIT HA SIDO RECHAZADO POR MEDIDAS DE SEGURIDAD.${NC}"
    echo "1. Nunca guardes llaves reales en el código fuente ni en el historial de Git."
    echo "2. Usa variables de entorno (.env) o inyección segura (build.gradle / AppConfig)."
    echo "3. Si una clave ya fue detectada por GitGuardian o expuesta, DEBES revocarla en GCP."
    echo "======================================================================"
    exit 1
fi

echo "${GREEN}✔ Chequeo de seguridad aprobado: no se encontraron secretos en staged.${NC}"
exit 0
